<odoo>
    <record id="view_repair_order_form_hide_picked" model="ir.ui.view">
        <field name="name">repair.order.form.hide.picked</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='move_ids']/list/field[@name='picked']"
                position="attributes"
            >
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
