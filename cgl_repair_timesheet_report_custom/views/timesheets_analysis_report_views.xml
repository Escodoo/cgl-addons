<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="repair_timesheets_analysis_report_list" model="ir.ui.view">
        <field name="name">timesheets.analysis.report.repair.list</field>
        <field name="model">timesheets.analysis.report</field>
        <field name="arch" type="xml">
            <list string="Repair Order Timesheets">
                <field name="date" />
                <field name="repair_order_id" />
                <field name="employee_id" />
                <field name="name" string="Activity" />
                <field name="unit_amount" widget="timesheet_uom" sum="Total" />
            </list>
        </field>
    </record>

    <record id="repair_timesheets_analysis_report_pivot" model="ir.ui.view">
        <field name="name">timesheets.analysis.report.repair.pivot</field>
        <field name="model">timesheets.analysis.report</field>
        <field name="arch" type="xml">
            <pivot string="Repair Order Timesheets" sample="1">
                <field name="employee_id" type="row" />
                <field name="repair_order_id" type="row" />
                <field name="date" interval="month" type="col" />
                <field name="unit_amount" type="measure" widget="timesheet_uom" />
            </pivot>
        </field>
    </record>

    <record id="repair_timesheets_analysis_report_graph" model="ir.ui.view">
        <field name="name">timesheets.analysis.report.repair.graph</field>
        <field name="model">timesheets.analysis.report</field>
        <field name="arch" type="xml">
            <graph string="Repair Order Timesheets" sample="1">
                <field name="employee_id" type="row" />
                <field name="unit_amount" type="measure" widget="timesheet_uom" />
            </graph>
        </field>
    </record>

    <record id="repair_timesheets_analysis_report_search" model="ir.ui.view">
        <field name="name">timesheets.analysis.report.repair.search</field>
        <field name="model">timesheets.analysis.report</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_report_search" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='groupby']" position="inside">
                <field name="repair_order_id" />
                <filter
                    string="Repair Order"
                    name="groupby_repair_order"
                    domain="[]"
                    context="{'group_by': 'repair_order_id'}"
                />
            </xpath>
        </field>
    </record>

    <record id="action_repair_timesheets_analysis_report" model="ir.actions.act_window">
        <field name="name">Timesheets Report</field>
        <field name="res_model">timesheets.analysis.report</field>
        <field name="domain">[('repair_order_id', '!=', False)]</field>
        <field
            name="context"
        >{'search_default_groupby_employee': 1, 'search_default_groupby_repair_order': 1}</field>
        <field name="search_view_id" ref="repair_timesheets_analysis_report_search" />
        <field name="view_mode">pivot,list,graph</field>
    </record>

    <record
        id="action_repair_timesheets_analysis_report_pivot"
        model="ir.actions.act_window.view"
    >
        <field name="sequence" eval="1" />
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="repair_timesheets_analysis_report_pivot" />
        <field name="act_window_id" ref="action_repair_timesheets_analysis_report" />
    </record>

    <record
        id="action_repair_timesheets_analysis_report_list"
        model="ir.actions.act_window.view"
    >
        <field name="sequence" eval="2" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="repair_timesheets_analysis_report_list" />
        <field name="act_window_id" ref="action_repair_timesheets_analysis_report" />
    </record>

    <record
        id="action_repair_timesheets_analysis_report_graph"
        model="ir.actions.act_window.view"
    >
        <field name="sequence" eval="3" />
        <field name="view_mode">graph</field>
        <field name="view_id" ref="repair_timesheets_analysis_report_graph" />
        <field name="act_window_id" ref="action_repair_timesheets_analysis_report" />
    </record>

    <menuitem
        id="menu_repair_timesheets_analysis_report"
        name="Timesheets Report"
        parent="repair.repair_menu_reporting"
        action="action_repair_timesheets_analysis_report"
        sequence="10"
    />
</odoo>
