<odoo noupdate="1">
    <record id="analytic_plan_equipamentos" model="account.analytic.plan">
        <field name="name">Equipamentos</field>
    </record>

    <record
        id="analytic_applicability_equipamentos_purchase"
        model="account.analytic.applicability"
    >
        <field name="business_domain">purchase_order</field>
        <field name="applicability">optional</field>
        <field name="analytic_plan_id" ref="analytic_plan_equipamentos" />
    </record>

    <record
        id="analytic_account_equipamentos_escavadeira"
        model="account.analytic.account"
    >
        <field name="name">03 - ESCAVADEIRA</field>
        <field name="plan_id" ref="analytic_plan_equipamentos" />
    </record>

    <record
        id="analytic_account_equipamentos_retroescavadeira"
        model="account.analytic.account"
    >
        <field name="name">04 - RETROESCAVADEIRA</field>
        <field name="plan_id" ref="analytic_plan_equipamentos" />
    </record>
</odoo>
