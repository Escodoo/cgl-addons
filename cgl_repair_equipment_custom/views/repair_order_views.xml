<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_repair_order_form_equipment" model="ir.ui.view">
        <field name="name">repair.order.form.equipment</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field
                    name="equipment_id"
                    options="{'no_create': True}"
                    readonly="state in ['cancel', 'done']"
                />
            </xpath>
        </field>
    </record>

    <record id="view_repair_order_tree_equipment" model="ir.ui.view">
        <field name="name">repair.order.list.equipment</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="equipment_id" readonly="1" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
