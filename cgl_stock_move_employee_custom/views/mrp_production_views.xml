<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_production_form_view_user" model="ir.ui.view">
        <field name="name">mrp.production.form.user</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='move_raw_ids']//field[@name='location_id']"
                position="after"
            >
                <field name="user_id" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
