<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_repair_order_form_user" model="ir.ui.view">
        <field name="name">repair.order.form.user</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='move_ids']//field[@name='product_id']"
                position="after"
            >
                <field name="user_id" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
