<odoo>
    <record id="cgl_obra_stock_report_view_pivot" model="ir.ui.view">
        <field name="name">cgl.obra.stock.report.pivot</field>
        <field name="model">cgl.obra.stock.report</field>
        <field name="arch" type="xml">
            <pivot string="Materiais em Obra">
                <field name="obra_id" type="row" />
                <field name="tipo" type="col" />
                <field name="reason_code_id" type="col" />
                <field name="quantity" type="measure" />
                <field name="value" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="cgl_obra_stock_report_view_list" model="ir.ui.view">
        <field name="name">cgl.obra.stock.report.list</field>
        <field name="model">cgl.obra.stock.report</field>
        <field name="arch" type="xml">
            <list string="Materiais em Obra" default_order="date desc" create="false">
                <field name="date" />
                <field name="obra_id" />
                <field name="product_id" />
                <field name="tipo" />
                <field name="reason_code_id" />
                <field name="quantity" />
                <field name="value" />
            </list>
        </field>
    </record>

    <record id="cgl_obra_stock_report_view_graph" model="ir.ui.view">
        <field name="name">cgl.obra.stock.report.graph</field>
        <field name="model">cgl.obra.stock.report</field>
        <field name="arch" type="xml">
            <graph string="Materiais em Obra" type="bar">
                <field name="obra_id" />
                <field name="tipo" />
                <field name="value" type="measure" />
            </graph>
        </field>
    </record>

    <record id="cgl_obra_stock_report_action" model="ir.actions.act_window">
        <field name="name">Materiais em Obra</field>
        <field name="res_model">cgl.obra.stock.report</field>
        <field name="view_mode">pivot,list,graph</field>
    </record>

    <menuitem
        id="menu_cgl_obra_stock_report"
        name="Materiais em Obra"
        parent="stock.menu_warehouse_report"
        action="cgl_obra_stock_report_action"
        sequence="60"
    />
</odoo>
