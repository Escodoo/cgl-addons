<odoo>
    <record id="res_config_settings_view_form_obra" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.obra</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="warehouse_setting_container" position="after">
                <block
                    title="Mobilização de Materiais"
                    name="obra_mobilization_setting_container"
                >
                    <setting
                        id="obra_stock_location_setting"
                        help="Local intermediário que representa material fora da CGL, em obras"
                    >
                        <field
                            name="obra_stock_location_id"
                            options="{'no_create': True}"
                        />
                    </setting>
                    <setting
                        id="obra_analytic_plan_setting"
                        help="Plano analítico usado para identificar a obra em cada movimentação"
                    >
                        <field
                            name="obra_analytic_plan_id"
                            options="{'no_create': True}"
                        />
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
